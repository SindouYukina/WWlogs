# Private local files
# Development-only font candidates and proprietary font sources stay local.
/work/fonts/src/misans/
/work/fonts/candidates/
/AGENTS.md
/HANDOFF.md
/bin/
/cmd/capture/wwlogs_windows_amd64.syso
/cmd/desktop/wwlogs_windows_amd64.syso
/docs/
/research/
/logs/
/references/
/work/

# Product game images: only WebP images, their manifest and its README are tracked under assets/, so caches, previews,
# source extracts and anything else placed there stay local.
/assets/**
!/assets/**/
!/assets/README.md
!/assets/manifest.json
!/assets/game/**/*.webp

# Secrets and machine-local artifacts
Thumbs.db
.env
.env.*
*.pem
*.key
*private*key*
*session*key*
*.pcap
*.pcapng
*.ndjson
*.log
*.exe
*.dll
*.so
*.pak

# Diagnostic and capture artifacts must never be tracked
*.jsonl
*.cap
*.der
*.bundle
/capture-spool/
/.claude/

# Local frontend installs and builds; product builds use a temporary copy outside the repository
/frontend/node_modules/
/frontend/dist/
